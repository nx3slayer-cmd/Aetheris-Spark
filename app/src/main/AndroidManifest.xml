<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".KallistoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_free"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_free"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <!-- Root Activity (Entry point without direct launcher filter) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 1. FREE TIER ICON ALIAS (Default Enabled) -->
        <activity-alias
            android:name=".MainActivityAliasFree"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_free"
            android:roundIcon="@mipmap/ic_launcher_free"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 2. PRO PLATINUM ICON ALIAS (Default Pro) -->
        <activity-alias
            android:name=".MainActivityAliasProPlatinum"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pro_platinum"
            android:roundIcon="@mipmap/ic_launcher_pro_platinum"
            android:label="Kallisto Pro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3. PRO GOLD ICON ALIAS -->
        <activity-alias
            android:name=".MainActivityAliasProGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pro_gold"
            android:roundIcon="@mipmap/ic_launcher_pro_gold"
            android:label="Kallisto Pro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 4. PRO AMETHYST ICON ALIAS -->
        <activity-alias
            android:name=".MainActivityAliasProAmethyst"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pro_amethyst"
            android:roundIcon="@mipmap/ic_launcher_pro_amethyst"
            android:label="Kallisto Pro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 5. PRO EMERALD ICON ALIAS -->
        <activity-alias
            android:name=".MainActivityAliasProEmerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pro_emerald"
            android:roundIcon="@mipmap/ic_launcher_pro_emerald"
            android:label="Kallisto Pro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.FloatingOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
